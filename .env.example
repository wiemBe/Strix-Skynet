# Skynet yapılandırması. Bu dosyayı .env olarak kopyalayın. .env repoya girmez.

# Ağ. 0.0.0.0 ile ağa açarken bir reverse proxy (TLS) arkasında çalıştırın ve SKYNET_COOKIE_SECURE=1 yapın.
SKYNET_HOST=127.0.0.1
SKYNET_PORT=8787
SKYNET_COOKIE_SECURE=0

# Yerleşik admin hesabı (her zaman etkin admin; diğer kullanıcılar Settings > Users'tan yönetilir).
# SKYNET_PASSWORD boşsa ilk açılışta rastgele şifre üretilir ve data/admin_password.txt dosyasına yazılır.
SKYNET_USER=admin
SKYNET_PASSWORD=
SKYNET_SESSION_HOURS=12

# Gizli değerlerin (LLM anahtarları, hedef kimlik bilgileri, CI token) şifreleme anahtarı.
# Boşsa mevcut anahtar kullanılır; ilk kurulumda ~/.config/skynet/secret.key üretilir (data/ dışında).
# Mevcut şifreli veriyi taşırken aynı anahtarı taşıyın; yeni anahtar üretmeyin.
# Yalnız YENİ kurulumda secret manager için örnek:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SKYNET_SECRET_KEY=
# SKYNET_SECRET_KEY_FILE=/var/lib/skynet-keys/secret.key

# Zamanlamaların varsayılan saat dilimi
SKYNET_TIMEZONE=Europe/Istanbul

# Veri klasörü (SQLite, süreç logları, geçici çalışma dosyaları)
SKYNET_DATA=./data

# İlk açılış varsayılanları (sonra Ayarlar sayfasından yönetilir)
SKYNET_STRIX_BIN=
SKYNET_STRIX_WORKDIR=~
# Boş binary yolu paketlenmiş .strix-runtime/bin/strix'i seçer; kayıtlı Settings değişmez.
# RHEL 9.4+: Python 3.12 paketlerini kurun; sistem Python 3.9'unu değiştirmeyin.
# SKYNET_PYTHON=/usr/bin/python3.12
# SKYNET_STRIX_PYTHON=/usr/bin/python3.12
# SKYNET_STRIX_RUNTIME=/opt/skynet/.strix-runtime/bin/python
