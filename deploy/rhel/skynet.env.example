# systemd EnvironmentFile syntax. No shell substitution. Keep this file root-owned, mode 0600.
SKYNET_LOAD_DOTENV=0
SKYNET_HOST=127.0.0.1
SKYNET_PORT=8787
# Same-host Nginx: keep the backend on loopback. HTTP=0; HTTPS=1 (docs/NGINX.md).
SKYNET_COOKIE_SECURE=0
SKYNET_USER=admin
# Empty only on a new installation: first start writes a random password to /var/lib/skynet/admin_password.txt.
SKYNET_PASSWORD=
SKYNET_TIMEZONE=Europe/Istanbul
SKYNET_DATA=/var/lib/skynet
SKYNET_SECRET_KEY_FILE=/var/lib/skynet-keys/secret.key
SKYNET_STRIX_BIN=/opt/skynet/.strix-runtime/bin/strix
SKYNET_STRIX_RUNTIME=/opt/skynet/.strix-runtime/bin/python
SKYNET_STRIX_WORKDIR=/var/lib/skynet/work
# Optional internal CA for LLM gateways (never disable TLS verification):
# SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt
# REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
